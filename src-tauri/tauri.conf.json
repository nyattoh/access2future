{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Access2Future",
  "version": "0.1.0",
  "identifier": "jp.access2future.planner",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../public/vendor/mermaid-LICENSE.txt": "licenses/mermaid-LICENSE.txt",
      "../scripts/export-access.ps1": "scripts/export-access.ps1",
      "../scripts/vba-analysis.ps1": "scripts/vba-analysis.ps1"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"]
      }
    }
  }
}
