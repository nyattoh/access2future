{
  "name": "access2future",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Local Microsoft Access migration planning application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/native-smoke.ps1",
    "vendor:mermaid": "node scripts/vendor-mermaid.mjs",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace"
  },
  "devDependencies": {
    "@mermaid-js/tiny": "12.1.0"
  }
}
